# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export GOBIN="$HOME/go/bin"
path=(
	$path
	$GOBIN
	$HOME/.bin
	$HOME/scripts
	$HOME/.cargo/bin
	$HOME/.local/bin
	$HOME/.sg
	$HOME/Library/pnpm
	/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin
	/Applications/Postgres.app/Contents/Versions/latest/bin
)

export PNPM_HOME="$HOME/Library/pnpm"

# General env
export LANG=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export XDG_CONFIG_HOME="$HOME/.config"
export CC=$(which gcc)
export LESS='-R -i -M -F -X'

export TERM=screen-256color
export COLORTERM=truecolor
export EDITOR=nvim
export USE_EDITOR=$EDITOR
export VISUAL=$EDITOR
export MANPAGER='nvim +Man!'
export GPG_TTY=$(tty)

fpath=("$HOME/.config/zsh/functions" $fpath)

# History
HISTFILE=$HOME/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt append_history
setopt extended_history
setopt hist_verify
setopt share_history
setopt hist_ignore_dups
setopt inc_append_history

# Directory Options
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushd_silent
setopt extended_glob

# Emacs keybindings
# for more info, man zshzle
bindkey -e

setopt INTERACTIVE_COMMENTS

# FZF options
export FZF_CTRL_T_COMMAND='sqlite3 "$HOME/Library/Application Support/fre/fre.sqlite" "select name from frecency order by t_unit_frecency desc"'
export FZF_CTRL_T_OPTS='--tiebreak=index --no-sort --bind tab:down --bind shift-tab:up'
source "$XDG_CONFIG_HOME/zsh/fzf-key-bindings.zsh"

# Update fre on directory change
fre_chpwd() {
	local dir=$(realpath "$(pwd)")
	sqlite3 "$HOME/Library/Application Support/fre/fre.sqlite" \
		-cmd ".parameter set :name \"$dir\"" \
		-cmd ".parameter set :t_visit $(date +%s)" \
		-cmd ".parameter set :half_life 604800" \
<<EOF
	INSERT INTO frecency (name, t_unit_frecency)
	VALUES (:name, :t_visit)
	ON CONFLICT (name) DO UPDATE SET
		t_unit_frecency = CASE
			WHEN :t_visit < t_unit_frecency
			THEN t_unit_frecency + :half_life * log2(1 + pow(2, (:t_visit - t_unit_frecency) / :half_life))
			ELSE :t_visit + :half_life * log2(1 + pow(2, (t_unit_frecency - :t_visit) / :half_life))
		END;
EOF
}
typeset -gaU chpwd_functions
chpwd_functions+=fre_chpwd

# Use podman
export DOCKER_HOST=unix://$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}')

if command -v mise &> /dev/null; then
	eval "$(mise activate zsh)"
fi

# jj completions
if command -v jj &> /dev/null; then
	source <(jj util completion zsh)
fi

# Workspace helpers live in zsh so they can cd the current shell after creating
# or selecting a workspace.
_jj_ws_base_root() {
	local workspace_root=$(command jj workspace root) || return 1
	if [[ "$workspace_root" == */.workspaces/* ]]; then
		print -r -- "${workspace_root%%/.workspaces/*}"
	else
		print -r -- "$workspace_root"
	fi
}

_jj_ws_new() {
	local name="$1"
	if [[ -n "$name" ]]; then
		shift
	fi
	if [[ -z "$name" ]]; then
		read "name?Workspace name: "
	fi
	if [[ -z "$name" ]]; then
		echo "No workspace name provided" >&2
		return 1
	fi

	local jj_workspace_root=$(_jj_ws_base_root) || return 1
	local ws_dir="$jj_workspace_root/.workspaces/$name"
	mkdir -p "$jj_workspace_root/.workspaces" || return 1
	command jj workspace add "$ws_dir" "$@" || return 1
	[[ -x "$jj_workspace_root/.jj/ws-setup" ]] && "$jj_workspace_root/.jj/ws-setup" "$ws_dir"
	cd "$ws_dir" || return 1
}

_jj_ws_delete() {
	local name="$1"
	if [[ -z "$name" ]]; then
		echo "No workspace selected" >&2
		return 1
	fi
	if [[ "$name" == "default" ]]; then
		echo "Refusing to delete the default workspace" >&2
		return 1
	fi

	local jj_workspace_root=$(_jj_ws_base_root) || return 1
	local current_root=$(command jj workspace root) || return 1
	local ws_dir="$jj_workspace_root/.workspaces/$name"
	if [[ "$current_root" == "$ws_dir" ]]; then
		echo "Refusing to delete the current workspace" >&2
		return 1
	fi

	local confirm
	read "confirm?Delete workspace '$name' and remove '$ws_dir'? [y/N] "
	if [[ "$confirm" != [yY] ]]; then
		return 0
	fi

	command jj workspace forget "$name" || return 1
	if [[ -d "$ws_dir" ]]; then
		rm -rf -- "$ws_dir" || return 1
	fi
}

_jj_ws_fzf() {
	local result key selection name jj_workspace_root ws_dir

	while true; do
		result=$(command jj workspace list | fzf \
			--prompt='jj workspace> ' \
			--height=40% \
			--reverse \
			--expect=ctrl-space,ctrl-x \
			--header='Enter: cd  Ctrl-Space: new  Ctrl-X: delete  Type to search') || return

		key=${result%%$'\n'*}
		selection=${result#*$'\n'}
		if [[ "$selection" == "$result" ]]; then
			selection="$key"
			key=""
		fi
		name=${selection%%:*}

		case "$key" in
			ctrl-space)
				_jj_ws_new
				return
				;;
			ctrl-x)
				_jj_ws_delete "$name" || return 1
				;;
			*)
				[[ -z "$name" ]] && return
				jj_workspace_root=$(_jj_ws_base_root) || return 1
				if [[ "$name" == "default" ]]; then
					ws_dir="$jj_workspace_root"
				else
					ws_dir="$jj_workspace_root/.workspaces/$name"
				fi
				cd "$ws_dir" || return 1
				return
				;;
		esac
	done
}

# Wrap jj so `jj ws new <name>` creates a workspace and cd's into it in the
# current shell (a jj util-exec alias can't change the parent shell's cwd).
# Bare `jj ws`/`jj workspace` opens the workspace fzf UI; other `jj ws`
# subcommands are forwarded to `jj workspace`.
jj() {
	case "$1" in
		ws)
			shift
			case "$1" in
				"")
					_jj_ws_fzf
					;;
				new)
					shift
					_jj_ws_new "$@"
					;;
				*)
					command jj workspace "$@"
					;;
			esac
			;;
		workspace)
			shift
			if [[ $# -eq 0 ]]; then
				_jj_ws_fzf
			else
				command jj workspace "$@"
			fi
			;;
		*)
			command jj "$@"
			;;
	esac
}
